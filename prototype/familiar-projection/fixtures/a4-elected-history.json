    },
    "h1": {
      "v": "familiar-projection/1",
      "key": "day-alice",
      "standing": "history",
      "window": [0, 5000],
      "generated_at": 40000,
      "valid_until": 340000,
      "sources": [
        {
          "id": "s1",
          "actor": "alice",
          "ref": "row:alice:0000",
          "rev": 1,
          "origin": "self",
          "authority": "notice",
          "audience": "lan",
          "valid_until": 5000
        }
      ],
      "claims": [
        {
          "id": "c1",
          "basis": "report",
          "about": "alice",
          "topics": ["merge"],
          "src": ["s1"],
          "text": "alice merged the first fix"
        }
      ]
    }
  },
  "steps": [
    {"t": 10000, "op": "frame", "body": "p1", "seq": 1, "expires_at": 130000, "expect": {"admit": "admitted"}},
    {"t": 20000, "op": "retain", "at": "r1", "claim": "p1#c1", "by": "principal", "expect": "kept"},
    {"t": 21000, "op": "retain", "at": "r1", "claim": "p1#c1", "by": "session", "expect": "refused"},
    {
      "t": 22000,
      "op": "read",
      "at": "r1",
      "view": "history",
      "expect": {
        "claims": ["kept:p1#c1"],
        "render_includes": [
          "[history] about alice, from familiar f00d000000000001",
