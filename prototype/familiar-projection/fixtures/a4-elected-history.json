    {"t": 40000, "op": "frame", "body": "h1", "seq": 3, "expires_at": 160000, "expect": {"admit": "admitted"}},
    {"t": 41000, "op": "read", "at": "r1", "view": "current", "expect": {"claims": [], "topic_support": {"merge": 0}}},
    {
      "t": 41000,
      "op": "read",
      "at": "r1",
