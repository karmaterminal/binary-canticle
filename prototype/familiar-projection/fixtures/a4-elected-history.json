{
  "v": "familiar-projection-fixture/1",
  "name": "a4-elected-history",
  "case": "AC4",
  "synthetic": true,
  "about": "A principal elects to keep one claim. It stays attributed and marked historical after its source is withdrawn, never returns to the current view or default search, and never counts as support. A session cannot keep heard content. A producer's history-standing projection is shown only as history.",
  "defaults": {"key_id": "f00d000000000001", "station": "familiar", "stream": "wake", "scope": "lan", "epoch": 1},
  "receivers": {"r1": {"topics": ["merge"], "window_ms": 10000}},
  "bodies": {
