    {"t": 31000, "op": "read", "at": "r1", "view": "search", "q": "merge", "expect": {"claims": []}},
    {
      "t": 31000,
      "op": "read",
      "at": "r1",
      "view": "search",
      "q": "merge",
      "history": true,
      "expect": {"claims": ["kept:p1#c1"]}
