          "> alice merged the fix"
        ]
      }
    },
    {
      "t": 22000,
      "op": "read",
      "at": "r1",
      "view": "current",
      "expect": {"claims": ["p1#c1"], "topic_support": {"merge": 1}}
    },
    {"t": 25000, "op": "present", "at": "r1", "expect": {"presented": ["p1#c1"]}},
    {"t": 30000, "op": "frame", "body": "w1", "seq": 2, "expires_at": 150000, "expect": {"admit": "admitted"}},
    {
      "t": 31000,
      "op": "read",
      "at": "r1",
      "view": "current",
      "expect": {"claims": [], "status": {"p1#c1": "withdrawn"}, "topic_support": {"merge": 0}}
