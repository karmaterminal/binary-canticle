{
  "id": "canticle",
  "name": "Canticle",
  "description": "Hear the canticle through the host daemon, keep a bounded heard journal, and sing through this prince's own station.",
  "activation": { "onStartup": true },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["binding", "daemon"],
    "properties": {
      "binding": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,30}$" },
      "daemon": {
        "type": "object",
        "additionalProperties": false,
        "required": ["socket"],
        "properties": {
          "socket": { "type": "string", "minLength": 1 },
          "uid": { "type": "integer", "minimum": 0 }
        }
      },
      "stateDir": { "type": "string", "minLength": 1 },
      "station": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "keyId"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,30}$" },
          "keyId": { "type": "string", "pattern": "^[0-9a-f]{16}$" }
        }
      },
      "listen": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tune": { "type": "array", "maxItems": 64, "items": { "type": "string", "maxLength": 100 } },
          "includeSelf": { "type": "boolean" },
          "payloadSessions": { "type": "array", "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 201 } }
        }
      },
      "journal": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "maxEntries": { "type": "integer", "minimum": 100, "maximum": 100000 },
          "maxBytes": { "type": "integer", "minimum": 65536, "maximum": 268435456 },
          "maxAgeHours": { "type": "integer", "minimum": 1, "maximum": 720 }
        }
      },
      "publish": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean" },
          "socket": { "type": "string", "minLength": 1 },
          "uid": { "type": "integer", "minimum": 0 },
          "classes": {
            "type": "array",
            "items": { "type": "string", "enum": ["chatter", "ambient", "live-state", "advisory", "finding-ref", "root"] }
          },
          "perMinute": { "type": "integer", "minimum": 1, "maximum": 5 },
          "perHour": { "type": "integer", "minimum": 1, "maximum": 60 },
          "maxLive": { "type": "integer", "minimum": 1, "maximum": 64 }
        }
      },
      "delivery": {
        "type": "object",
        "additionalProperties": false,
        "properties": { "mode": { "type": "string", "enum": ["explicit"] } }
      },
      "subscriptions": { "type": "array", "maxItems": 64, "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "targets"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 31 },
          "stations": { "type": "array", "maxItems": 64, "items": { "type": "string" } },
          "streams": { "type": "array", "maxItems": 64, "items": { "type": "string" } },
          "classes": { "type": "array", "maxItems": 64, "items": { "type": "string" } },
          "scopes": { "type": "array", "maxItems": 64, "items": { "type": "string" } },
          "lenses": { "type": "array", "maxItems": 64, "items": { "type": "string" } },
          "targets": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "object", "additionalProperties": false, "required": ["sessionKey"], "properties": { "sessionKey": { "type": "string", "minLength": 1, "maxLength": 200 } } } },
          "delivery": { "type": "string", "enum": ["ringbuffer_only", "ambient"] },
          "perHour": { "type": "integer", "minimum": 1, "maximum": 600 }
        }
      } },
      "discovery": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "domains": { "type": "array", "maxItems": 8, "items": { "type": "string", "maxLength": 253 } },
          "catalog": { "type": "array", "maxItems": 128, "items": {
            "type": "object", "additionalProperties": false, "required": ["name", "publicKey", "publicStreams"],
            "properties": {
              "name": { "type": "string", "maxLength": 31 },
              "publicKey": { "type": "string", "minLength": 44, "maxLength": 44 },
              "publicStreams": { "type": "array", "maxItems": 32, "items": { "type": "string", "maxLength": 100 } }
            }
          } }
        }
      }
    }
  },
  "contracts": {
    "tools": ["canticle_listen", "canticle_status", "canticle_mute", "canticle_discover", "canticle_sing", "canticle_hush", "canticle_outbox"]
  },
  "toolMetadata": {
    "canticle_listen": { "optional": true },
    "canticle_status": { "optional": true },
    "canticle_mute": { "optional": true },
    "canticle_discover": { "optional": true },
    "canticle_sing": { "optional": true },
    "canticle_hush": { "optional": true },
    "canticle_outbox": { "optional": true }
  }
}
